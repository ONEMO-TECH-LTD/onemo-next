{
  "name": "@onemo/studio-v2",
  "version": "0.1.0",
  "description": "ONEMO Studio v2 desktop editor",
  "author": "ONEMO",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --mac dir",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "^0.183.2",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.7.4"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "studio.onemo.app",
    "productName": "Studio",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public/assets",
        "to": "assets"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": null
    }
  }
}
