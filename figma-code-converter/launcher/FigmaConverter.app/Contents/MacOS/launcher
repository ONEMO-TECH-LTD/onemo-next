#!/bin/bash
# Figma Converter launcher v2 — dockable, checkout-agnostic.
# The converter can live in the main clone OR any worktree; the launcher asks WHICH folder to
# run from (remembers the last choice, 5s auto-continue), so the app survives worktree deletion.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
CFG_DIR="$HOME/.figma-converter"; CFG="$CFG_DIR/root"; mkdir -p "$CFG_DIR"
STUDIO_URL="http://127.0.0.1:3900"
fail(){ osascript -e "display alert \"Figma Converter\" message \"$1\""; exit 1; }
up(){ curl -s -o /dev/null -m 2 -w '%{http_code}' "$1" 2>/dev/null; }
valid(){ [ -f "$1/studio/server.mjs" ]; }
choose(){ osascript -e 'POSIX path of (choose folder with prompt "Select the figma-code-converter folder (main clone or a worktree):")' 2>/dev/null | sed 's:/$::'; }

# ── pick the converter root: remembered choice with a quick switch, else folder picker ──
TOOL="$(cat "$CFG" 2>/dev/null)"
if valid "$TOOL"; then
  BTN=$(osascript -e "display dialog \"Run the converter from:\n$TOOL\" buttons {\"Choose Folder…\",\"Use This\"} default button \"Use This\" giving up after 5 with title \"Figma Converter\"" -e 'button returned of result' 2>/dev/null)
  [ "$BTN" = "Choose Folder…" ] && TOOL="$(choose)"
else
  TOOL="$(choose)"
fi
[ -n "$TOOL" ] || exit 0                       # user cancelled
valid "$TOOL" || fail "That folder has no studio/server.mjs — pick the figma-code-converter folder itself."
echo "$TOOL" > "$CFG"
APP_REPO="$(cd "$TOOL/.."; pwd)"
command -v node >/dev/null || fail "node not found on PATH"

# ── studio (:3900): if one is already up for a DIFFERENT checkout, restart it on the chosen one ──
if [ "$(up $STUDIO_URL)" = "200" ]; then
  CUR=$(curl -s -m 2 "$STUDIO_URL/api/root" | sed -n 's/.*"tool":"\([^"]*\)".*/\1/p')
  if [ -n "$CUR" ] && [ "$CUR" != "$TOOL" ]; then pkill -f "node studio/server.mjs"; sleep 1; fi
fi
if [ "$(up $STUDIO_URL)" != "200" ]; then
  ( cd "$TOOL" && nohup node studio/server.mjs >/tmp/figma-converter-studio.log 2>&1 & )
fi
# ── Next dev app (:3077): needed to render; if it serves a different checkout, say so, don't kill it ──
if [ "$(up http://127.0.0.1:3077)" = "000" ]; then
  ( cd "$APP_REPO" && PORT=3077 nohup npm run dev >/tmp/figma-converter-next.log 2>&1 & )
fi
for i in $(seq 1 40); do [ "$(up $STUDIO_URL)" = "200" ] && break; sleep 1; done
[ "$(up $STUDIO_URL)" = "200" ] || fail "studio did not start — see /tmp/figma-converter-studio.log"
if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args --app="$STUDIO_URL"
else
  open "$STUDIO_URL"
fi
