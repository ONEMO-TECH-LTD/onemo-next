# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env.local
.env.*.local
.env

# claude code (user-specific settings)
.claude/settings.local.json

# cursor (machine-specific plugin config)
.cursor/

# task locks (ephemeral, per-agent)
current_tasks/

# playwright MCP logs (regenerated by plugin)
.playwright-mcp/

# firecrawl research cache
.firecrawl/

# vercel
.vercel

# design system working files (Figma exports, extraction scripts, temp outputs)
Design System/

# old brain transfer docs (superseded by .claude/rules/)
CLAUDE BRAIN /

# env snapshots
.env.production.vercel

# claude-mem debug notes
claude-mem-fix-*.md

# context drafts
context/CLAUDE.md

# claude auto-generated context files
.claude/CLAUDE.md
.claude/agents/CLAUDE.md
.claude/hooks/CLAUDE.md
.claude/skills/CLAUDE.md

# temp scripts
tmp-*.mjs
tmp-*.ts
tmp-*.js

# temp scripts
tmp-*.mjs
tmp-*.ts
tmp-*.js

# typescript
*.tsbuildinfo
next-env.d.ts

# Codex/agent verification artifacts
.artifacts/
.claude/worktrees/

# effect-creator v3 dev artifacts
.dev-factory-renders/
# self-hosted BEN2 weights (G5) — mirrored locally, never committed
public/models/

# preserve-at-ingest originals (dev channel — never in git)
.dev-originals/

# parallel-build caches (v1/v2/v3 dev dirs)
.next-v*/
storybook-static

# figma-to-code studio sandbox (unaccepted conversions — promoted screens are committed instead)
src/app/(dev)/converted/sandbox/
public/audit/sandbox/

.playwright-cli/

# macOS Finder metadata (custom-folder-icon resource stub + directory store)
Icon\r
**/Icon\r
.DS_Store
**/.DS_Store
browsertime-results/
