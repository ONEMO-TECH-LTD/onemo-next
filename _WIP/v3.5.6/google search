            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }
    </style>
</head>
<body>

    <div id="header">
        <button id="btn-v1" class="active" onclick="switchSimulation(1)">V1: Soft-Body Blob Wrapping</button>
        <button id="btn-v2" onclick="switchSimulation(2)">V2: Rigid Lattice Nesting</button>
        <button onclick="resetSimulation()">Reset View</button>
    </div>

    <div id="canvas-container">
        <canvas id="simCanvas"></canvas>
    </div>

<script>
const canvas = document.getElementById('simCanvas');
const ctx = canvas.getContext('2d');

let width = 600;
let height = 600;
let currentSim = 1;

// Base Simulation State Variables
let disks = [];
let blobNodes = [];
let blobConstraints = [];

// Rigid Matrix State Variables (V2)
let gridState = { x: 300, y: 300, rotation: 0 };
let rigidPolygon = [];
let originalPolygon = [];
let polygonScale = 1.0;

function resizeCanvas() {
    const size = Math.min(window.innerWidth, window.innerHeight - 80, 600);
    width = size;
    height = size;
    canvas.width = width;
    canvas.height = height;
    resetSimulation();
}

// ==========================================
// VARIATION 1: SOFT-BODY BLOB WRAPPING
// ==========================================
function initSimulationV1() {
    disks = [];
    blobNodes = [];
    blobConstraints = [];
    
    // 1. Generate random rigid disks inside
    const diskCount = 8;
    for (let i = 0; i < diskCount; i++) {
        disks.push({
            x: width / 2 + (Math.random() - 0.5) * 120,
            y: height / 2 + (Math.random() - 0.5) * 120,
            radius: 20 + Math.random() * 15,
            vx: 0, vy: 0
        });
    }

    // 2. Setup outer flexible particle boundary (Verlet loop)
    const nodeCount = 80;
    const center = { x: width / 2, y: height / 2 };
    const radius = 220;

    for (let i = 0; i < nodeCount; i++) {
        const angle = (i / nodeCount) * Math.PI * 2;
        const x = center.x + Math.cos(angle) * radius;
        const y = center.y + Math.sin(angle) * radius;
        blobNodes.push({ x: x, y: y, px: x, py: y });
    }

    // 3. Connect particles with distance constraints
    for (let i = 0; i < nodeCount; i++) {
        const nextIdx = (i + 1) % nodeCount;
        const dx = blobNodes[i].x - blobNodes[nextIdx].x;
        const dy = blobNodes[i].y - blobNodes[nextIdx].y;
        const len = Math.sqrt(dx * dx + dy * dy);
        blobConstraints.push({ p1: i, p2: nextIdx, targetLength: len });
    }
}

function updateSimulationV1() {
    // Phase A: Disk-to-Disk Collisions
    for (let i = 0; i < disks.length; i++) {
        for (let j = i + 1; j < disks.length; j++) {
            const d1 = disks[i];
            const d2 = disks[j];
            const dx = d2.x - d1.x;
            const dy = d2.y - d1.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const minDist = d1.radius + d2.radius;
            
            if (dist < minDist) {
                const overlap = minDist - dist;
                const nx = dx / (dist || 1);
                const ny = dy / (dist || 1);
                // Displace them equally apart
                d1.x -= nx * overlap * 0.5;
                d1.y -= ny * overlap * 0.5;
                d2.x += nx * overlap * 0.5;
                d2.y += ny * overlap * 0.5;
            }
        }
    }

    // Phase B: Verlet Integration for Blob Nodes
    for (let p of blobNodes) {
        const vx = p.x - p.px;
        const vy = p.y - p.py;
        p.px = p.x;
        p.py = p.y;
        p.x += vx;
        p.y += vy;
        
        // Minor continuous inward drag to assist tension
        const dx = (width / 2) - p.x;
        const dy = (height / 2) - p.y;
        p.x += dx * 0.001;
        p.y += dy * 0.001;
    }

    // Phase C: Constraint Contraction (Shrinking Core)
    for (let c of blobConstraints) {
        c.targetLength *= 0.994; // Decay resting link lengths over time
        
        const n1 = blobNodes[c.p1];
        const n2 = blobNodes[c.p2];
        const dx = n2.x - n1.x;
        const dy = n2.y - n1.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const diff = c.targetLength - dist;
        const percent = (diff / (dist || 1)) * 0.5;
        const ox = dx * percent;
        const oy = dy * percent;

        n1.x -= ox; n1.y -= oy;
        n2.x += ox; n2.y += oy;
    }

    // Phase D: Instant Zero-Gap Projection mapping
    for (let p of blobNodes) {
        for (let d of disks) {
            const dx = p.x - d.x;
            const dy = p.y - d.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            
            if (dist < d.radius) {
                const nx = dx / (dist || 1);
                const ny = dy / (dist || 1);
                // Snap directly onto outer surface perimeter with 0 gap
                p.x = d.x + nx * d.radius;
                p.y = d.y + ny * d.radius;
            }
        }
    }
}

function drawV1() {
    // Draw Disks
    ctx.fillStyle = '#ff3b30';
    for (let d of disks) {
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
    }

    // Draw Blob Fill and Line
    if(blobNodes.length > 0) {
        ctx.fillStyle = 'rgba(0, 118, 255, 0.2)';
        ctx.beginPath();
        ctx.moveTo(blobNodes[0].x, blobNodes[0].y);
        for(let i = 1; i < blobNodes.length; i++) {
            ctx.lineTo(blobNodes[i].x, blobNodes[i].y);
        }
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = '#0076ff';
        ctx.lineWidth = 3;
        ctx.stroke();
    }
}


// ==========================================
// VARIATION 2: RIGID LATTICE NESTING
// ==========================================
function initSimulationV2() {
    disks = [];
    polygonScale = 1.0;
    gridState = { x: width / 2, y: height / 2, rotation: 0 };

    // 1. Define rigid fixed 48px grid with 24px diameter disks (12px radius)
    const spacing = 48;
    const radius = 12;
    const rows = 7;
    const cols = 7;

    for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
            // Local offset coordinates relative to group center
            const lx = (c - (cols - 1) / 2) * spacing;
            const ly = (r - (rows - 1) / 2) * spacing;
            disks.push({ lx: lx, ly: ly, radius: radius, x: 0, y: 0 });
        }
    }

    // 2. Define a rigid complex non-deforming container polygon (a cove/valley layout)
    originalPolygon = [
        {x: -200, y: -200}, {x: 200, y: -200}, {x: 220, y: 100},
        {x: 80, y: 40},    {x: 0, y: 220},    {x: -80, y: 40},
        {x: -220, y: 100}
    ];
    updateWorldPolygonPoints();
}

function updateWorldPolygonPoints() {
    // Generate scaled layout of container centered on canvas
    rigidPolygon = originalPolygon.map(p => ({
        x: width / 2 + p.x * polygonScale,
        y: height / 2 + p.y * polygonScale
    }));
}

function updateSimulationV2() {
    // 1. Slow scale decrease of outer container
    if (polygonScale > 0.35) {
        polygonScale -= 0.001;
        updateWorldPolygonPoints();
    }

    // 2. Map local matrix disks to world tracking space
    const cosR = Math.cos(gridState.rotation);
    const sinR = Math.sin(gridState.rotation);
    for (let d of disks) {
        d.x = gridState.x + (d.lx * cosR - d.ly * sinR);
        d.y = gridState.y + (d.lx * sinR + d.ly * cosR);
    }

    // 3. Collision logic: Slide and pan entire grid globally when edges clip walls
    let globalForceX = 0;
    let globalForceY = 0;
    let globalTorque = 0;
    let contactPointsCount = 0;

    for (let d of disks) {
        // Line-by-line intersection check against rigid outer polygon walls
        for (let i = 0; i < rigidPolygon.length; i++) {
            const p1 = rigidPolygon[i];
            const p2 = rigidPolygon[(i + 1) % rigidPolygon.length];
            
            // Find closest line point vector to disk center
            const abx = p2.x - p1.x;
            const aby = p2.y - p1.y;
            const acx = d.x - p1.x;
            const acy = d.y - p1.y;
            
            const abLenSq = abx * abx + aby * aby;
            let t = (acx * abx + acy * aby) / (abLenSq || 1);

t = Math.max(0, Math.min(1, t)); // Constrain to line segment boundaries
const closestX = p1.x + t * abx;
const closestY = p1.y + t * aby;
const distVectorX = d.x - closestX;
const distVectorY = d.y - closestY;
const currentDist = Math.sqrt(distVectorX * distVectorX + distVectorY * distVectorY);
// Contact found: Wall clipping occurred
if (currentDist < d.radius) {
contactPointsCount++;
const overlap = d.radius - currentDist;
// Normal direction out from wall face
const nx = distVectorX / (currentDist || 1);
const ny = distVectorY / (currentDist || 1);
// Add to overall collective grid translation adjustment
globalForceX += nx * overlap * 0.4;
globalForceY += ny * overlap * 0.4;
// Rotational torque: leverage cross product (r x F) to spin grid smoothly into coves
const rx = d.x - gridState.x;
const ry = d.y - gridState.y;
const torque = (rx * ny * overlap) - (ry * nx * overlap);
globalTorque += torque * 0.0005;
}
}
}
// 4. Update the single unified transform matrix state (Preserves 48px rigidity 100%)
gridState.x += globalForceX;
gridState.y += globalForceY;
gridState.rotation += globalTorque;
}
function drawV2() {
// Draw Scaled Rigid Polygon Container Outer Wall
if (rigidPolygon.length > 0) {
ctx.fillStyle = '#1e1e1e';
ctx.beginPath();
ctx.moveTo(rigidPolygon[0].x, rigidPolygon[0].y);
for (let i = 1; i < rigidPolygon.length; i++) {
ctx.lineTo(rigidPolygon[i].x, rigidPolygon[i].y);
}
ctx.closePath();
ctx.fill();
ctx.strokeStyle = '#34c759';
ctx.lineWidth = 3;
ctx.stroke();
}
// Draw Rigidly Attached Grid Lattice Disks
ctx.fillStyle = '#0076ff';
for (let d of disks) {
ctx.beginPath();
ctx.arc(d.x, d.y, d.radius, 0, Math.PI * 2);
ctx.fill();
ctx.strokeStyle = 'rgba(255,255,255,0.4)';
ctx.lineWidth = 1;
ctx.stroke();
}
}
// ==========================================
// SIMULATION LIFE CYCLE ENGINE CONTROL
// ==========================================
function loop() {
ctx.clearRect(0, 0, width, height);
if (currentSim === 1) {
updateSimulationV1();
drawV1();
} else {
updateSimulationV2();
drawV2();
}
requestAnimationFrame(loop);
}
function switchSimulation(type) {
currentSim = type;
document.getElementById('btn-v1').classList.toggle('active', type === 1);
document.getElementById('btn-v2').classList.toggle('active', type === 2);
resetSimulation();
}
function resetSimulation() {
if (currentSim === 1) {
initSimulationV1();
} else {
initSimulationV2();
}
}
// Initial Hook
window.addEventListener('resize', resizeCanvas);
resizeCanvas();
requestAnimationFrame(loop);



### Architectural & Mathematical Highlights

1. **Variation 1 (Soft-Body Blob)**: 
   * Uses simple **Verlet integration** where vertex constraints drop structural target width length parameters dynamically via a `0.994` scaling coefficient on every loop step. 
   * Continuous boundary node checking detects internal disk radiuses and forces immediate vector placement mapping to achieve a true **zero-gap snap structural lock**.
2. **Variation 2 (Rigid Lattice Nesting)**: 
   * Keeps individual lattice layout positions strictly defined as local coordinate positions (`lx`, `ly`), preventing structural skewing or deformation.
   * Leverages composite cross-product torque calculation mechanics mapping off the main pivot translation origin node to naturally guide, slide, and rotate the lattice into deep pockets, without any disk breaking away from its **48px grid position requirement**.

