{
  "name": "@onemo/magnetic-logic",
  "version": "1.0.0",
  "description": "Versioned ONEMO magnetic product policy and manufacturing solver.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver.d.ts",
      "import": "./dist/src/solver.js"
    }
  },
  "files": [
    "dist",
    "src",
    "profiles",
    "tests",
    "README.md",
    "package.json",
    "PROFILE-GUIDE.md",
    "MANUFACTURING-SPEC.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@onemo/geometry-compute": "1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  }
}
