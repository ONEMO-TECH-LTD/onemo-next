{
  "name": "@onemo/geometry-compute",
  "version": "1.0.0",
  "description": "Product-neutral deterministic geometry kernel for ONEMO free-shape computation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tests",
    "benchmarks",
    "README.md",
    "MATHEMATICS.md",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@countertype/clipper2-ts": "1.5.4"
  }
}
