{
  "name": "@onemo/magnetic-next",
  "version": "1.0.0",
  "description": "React and Next.js adapter for the ONEMO magnetic engine.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "example",
    "tests",
    "README.md",
    "package.json",
    "INTEGRATION.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@onemo/magnetic-logic": "1.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=14"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  }
}
